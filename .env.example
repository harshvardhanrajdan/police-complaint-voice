# Required for Voice mode (OpenAI Realtime / WebRTC)
OPENAI_API_KEY=sk-...
# Optional overrides
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=coral
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# VAD: higher threshold = less background noise; longer silence = fewer mid-sentence cuts
OPENAI_VAD_THRESHOLD=0.78
OPENAI_VAD_SILENCE_MS=1400
OPENAI_NOISE_REDUCTION=near_field

# Draft assist desk (shown on printed complaint for further enquiry)
NEXT_PUBLIC_ASSISTANT_NAME=Police Complaint Assist — Citizen Desk
NEXT_PUBLIC_ASSISTANT_PHONE=1800-111-000
NEXT_PUBLIC_ASSISTANT_HOURS=Mon–Sat, 09:00–18:00 IST (draft support only)
NEXT_PUBLIC_CONTROL_ROOM=112
NEXT_PUBLIC_WOMEN_HELPLINE=181 / 1091
NEXT_PUBLIC_CYBER_HELPLINE=1930

# Optional: Supabase (recommended for Vercel deploy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Prefer service role on the server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Without Supabase, the app uses local file storage in .data/ (fine for localhost demo)
